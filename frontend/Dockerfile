FROM node:20-alpine
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG NEXT_PUBLIC_API_URL=https://enchanting-freedom-production-de16.up.railway.app
ARG NEXT_PUBLIC_ORG_NAME=
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_ORG_NAME=$NEXT_PUBLIC_ORG_NAME NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
RUN npm run build
EXPOSE 3000
ENV PORT=3000
CMD ["npm","start"]
