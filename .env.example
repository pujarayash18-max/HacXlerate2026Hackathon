ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=change-this-now
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Optional: enables the LLM-backed student copilot (falls back to rules if empty)
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-5-5

# Shown on the Privacy policy and Terms pages (set before launch; rebuild the web image after changing)
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Public address of the API as the browser sees it (change when you use a custom domain)
NEXT_PUBLIC_API_URL=http://localhost:8000
